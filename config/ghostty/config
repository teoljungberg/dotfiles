font-family = JetBrains Mono NL
font-size = 15
macos-option-as-alt = right
mouse-hide-while-typing = true
window-inherit-working-directory = false
window-new-tab-position = end

keybind = alt+right=unbind
# `scroll_to_selection` (the default) puts Ghostty into scrollback navigation
# mode, which intercepts keypresses -- including C-J -- instead of forwarding
# them to the running program.
keybind = super+j=unbind
keybind = shift+enter=csi:13;2u

keybind = cmd+shift+h=new_split:left
keybind = cmd+shift+j=new_split:down
keybind = cmd+shift+k=new_split:up
keybind = cmd+shift+l=new_split:right

palette = 0=#444444
palette = 1=#7D6566
palette = 2=#72784F
palette = 3=#847756
palette = 4=#6D689C
palette = 5=#9C6982
palette = 6=#5E7F90
palette = 7=#C0C0B0
palette = 8=#222222
palette = 9=#986C63
palette = 10=#576338
palette = 11=#604F3E
palette = 12=#7F636E
palette = 13=#957396
palette = 14=#969692
palette = 15=#E9E3D1
background = #F2F0DD
foreground = #444444
cursor-color = #694F35
cursor-text = #FFFFFF
selection-background = #CDCA77
selection-foreground = #111111

config-file = ?config.local
