copy-on-select = clipboard
font-family = JetBrains Mono NL
font-size = 15
macos-option-as-alt = right
macos-titlebar-style = tabs
mouse-hide-while-typing = true
window-inherit-working-directory = false
window-new-tab-position = end

keybind = alt+right=unbind
# `scroll_to_selection` (the default) puts Ghostty into scrollback navigation
# mode, which intercepts keypresses -- including C-J -- instead of forwarding
# them to the running program.
keybind = super+j=unbind
keybind = shift+enter=csi:13;2u

keybind = cmd+shift+h=new_split:left
keybind = cmd+shift+j=new_split:down
keybind = cmd+shift+k=new_split:up
keybind = cmd+shift+l=new_split:right

keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:down
keybind = cmd+alt+k=goto_split:up
keybind = cmd+alt+l=goto_split:right

palette = 0=#073642
palette = 1=#DA2825
palette = 2=#687800
palette = 3=#8F6C00
palette = 4=#2076B2
palette = 5=#CF2D7C
palette = 6=#217D76
palette = 7=#BBB5A2
palette = 8=#002B36
palette = 9=#C44815
palette = 10=#586E75
palette = 11=#657B83
