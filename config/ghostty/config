font-family = JetBrains Mono NL
font-size = 15
macos-option-as-alt = right
mouse-hide-while-typing = true
window-inherit-working-directory = false
window-new-tab-position = end

keybind = alt+right=unbind
# `scroll_to_selection` (the default) puts Ghostty into scrollback navigation
# mode, which intercepts keypresses -- including C-J -- instead of forwarding
# them to the running program.
keybind = super+j=unbind
keybind = shift+enter=csi:13;2u

keybind = cmd+shift+h=new_split:left
keybind = cmd+shift+j=new_split:down
keybind = cmd+shift+k=new_split:up
keybind = cmd+shift+l=new_split:right

keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:down
keybind = cmd+alt+k=goto_split:up
keybind = cmd+alt+l=goto_split:right

palette = 0=#444444
palette = 1=#9B6464
palette = 2=#607C60
palette = 3=#8B763D
palette = 4=#6D689C
palette = 5=#9C6982
palette = 6=#5E7F90
palette = 7=#C0C0B0
palette = 8=#222222
palette = 9=#AB6051
palette = 10=#4A6C43
palette = 11=#604F3E
palette = 12=#7F636E
palette = 13=#957396
palette = 14=#969692
palette = 15=#FDF6E3
background = #FDF6E3
foreground = #444444
cursor-color = #694F35
cursor-text = #FFFFFF
selection-background = #CDCA77
selection-foreground = #111111

config-file = ?config.local
